# 复制成同目录 .env 后填真值（.env 已在 .gitignore 里排除，禁止入库）。
# compose 的 env_file 把它整份注入 csmis-backend 容器，application.yml 里对应项只有 ${MIS_*:} 占位。

# 连接串里的 host 用 host.docker.internal：MySQL 是宿主机进程，不是容器
MIS_DB_URL=jdbc:mysql://host.docker.internal:3306/mss_insurance?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
MIS_DB_USERNAME=
MIS_DB_PASSWORD=

# JWT 签名密钥（生产必须覆盖）
JWT_SECRET=

# 报文国密开关（默认 true=SM4 加密 + SM2 签名 + 证书链验签；密钥/证书已打包在镜像 classpath）
# MSS_CRYPTO_ENABLED=true
# MSS_SM4_KEY=
